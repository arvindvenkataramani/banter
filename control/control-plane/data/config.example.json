{
  "version": 2,
  "runtime": {
    "host": "localhost",
    "eventsPath": "~/services/banter/logs/events.jsonl",
    "healthIntervalMs": 900000,
    "shardPollIntervalMs": 900000
  },
  "integrations": {
    "openclaw": {
      "gateway": {
        "url": "wss://your-gateway.example.com",
        "token": "your-gateway-token"
      },
      "defaultAgent": "your-agent-id"
    }
  },
  "voice": {
    "enabled": true,
    "tts": {
      "selection": {
        "serviceId": "fluid-tts",
        "model": "kokoro-ane",
        "voice": "heart",
        "speed": 1
      },
      "options": {
        "chunkStrategy": "greedy",
        "minChunkWords": 15,
        "maxChunkWords": 60
      },
      "settingsScope": "global",
      "modelPrefs": {}
    },
    "stt": {
      "serviceId": "fluid-stt",
      "model": "parakeet-unified-0.6b",
      "preferStreaming": true,
      "maxRecordingMs": 300000,
      "settleOnStopMs": 1500,
      "pauseFlushMs": 1500,
      "reveal": {
        "minIntervalMs": 55,
        "maxIntervalMs": 200
      },
      "reconnect": {
        "attempts": 3,
        "delayMs": 1000,
        "stableMs": 10000
      },
      "vad": {
        "minSpeechDurationS": 0.75,
        "minSpeechProb": 0.9
      },
      "turnTaking": {
        "pauseThresholdMs": 300,
        "commitMinDelayMs": 300,
        "commitMaxDelayMs": 1400,
        "smartTurnThreshold": 0.9,
        "smartTurnLowCutoff": 0.15,
        "curve": {
          "type": "power",
          "exponent": 2
        },
        "interruptionMinRemainingS": 0.5
      }
    }
  }
}
