{
  "_comment": "Minimal starting registry: this machine, the control plane, and one entry each for your speech-to-text and text-to-speech servers. Replace the placeholder ids, ports and health paths with your own — see the README's \"Connect your speech servers\". runner.type \"external\" means the platform only health-checks a service and never starts or stops it; switch to a \"process\" runner (with runner.main and ops.env.workingDirectory) if you want it started on demand and unloaded when idle. Add more hosts, capabilities and shards as you need them; docs/configuration.md covers every field.",
  "version": 2,
  "type": "control",
  "hosts": [
    {
      "id": "this-machine",
      "name": "this-machine",
      "hostname": "localhost",
      "role": "control"
    }
  ],
  "capabilities": [
    {
      "id": "control",
      "name": "Control Plane"
    },
    {
      "id": "stt",
      "name": "Speech-to-Text"
    },
    {
      "id": "tts",
      "name": "Text-to-Speech"
    }
  ],
  "services": [
    {
      "id": "control",
      "name": "Control Plane",
      "capabilityId": "control",
      "hostId": "this-machine",
      "permissions": {
        "enabled": true,
        "protected": true
      },
      "runner": {
        "type": "systemd",
        "unit": "banter",
        "unitFile": "ops/systemd/banter.service.template"
      },
      "network": {
        "port": 4200,
        "healthPath": "/api/health"
      },
      "lifecycle": {
        "loadStrategy": "startup",
        "idleUnload": false
      }
    },
    {
      "id": "stt-yours",
      "name": "Your STT",
      "capabilityId": "stt",
      "hostId": "this-machine",
      "permissions": {
        "enabled": true,
        "protected": false
      },
      "runner": {
        "type": "external"
      },
      "network": {
        "port": 8765,
        "healthPath": "/healthz"
      }
    },
    {
      "id": "tts-yours",
      "name": "Your TTS",
      "capabilityId": "tts",
      "hostId": "this-machine",
      "permissions": {
        "enabled": true,
        "protected": false
      },
      "runner": {
        "type": "external"
      },
      "network": {
        "port": 8002,
        "healthPath": "/health"
      }
    }
  ]
}
