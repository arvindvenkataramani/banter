{
  "_comment": "Ports appear twice per process service: in runner.main (what the service binds) and network.port (what we health-check and route to). They must agree unless the service sits behind a local proxy \u2014 the control plane warns on load if they differ. The CORS origins under ops.env.variables embed the dashboard's host and port a third time; update those too if either changes.",
  "version": 2,
  "type": "control",
  "servicesRoot": "~/services",
  "defaults": {
    "network": {
      "scheme": "https"
    }
  },
  "hosts": [
    {
      "id": "gpu-machine",
      "name": "gpu-machine",
      "hostname": "gpu-machine.your-tailnet.ts.net",
      "role": "worker"
    },
    {
      "id": "home-server",
      "name": "home-server",
      "hostname": "home-server.your-tailnet.ts.net",
      "role": "control"
    }
  ],
  "capabilities": [
    {
      "id": "control",
      "name": "Control Plane"
    },
    {
      "id": "dashboard",
      "name": "Dashboard"
    },
    {
      "id": "embedding",
      "name": "Embedding"
    },
    {
      "id": "tts",
      "name": "Text-to-Speech"
    },
    {
      "id": "stt",
      "name": "Speech-to-Text"
    },
    {
      "id": "llm",
      "name": "Large Language Model"
    },
    {
      "id": "voice",
      "name": "Voice Interface"
    },
    {
      "id": "documents",
      "name": "Documents"
    },
    {
      "id": "agents",
      "name": "Agent Orchestration"
    }
  ],
  "services": [
    {
      "id": "control",
      "name": "Control Plane",
      "capabilityId": "control",
      "hostId": "home-server",
      "permissions": {
        "enabled": true,
        "protected": true
      },
      "runner": {
        "type": "systemd",
        "unit": "banter",
        "unitFile": "ops/systemd/banter.service.template"
      },
      "network": {
        "port": 4200,
        "healthPath": "/api/health",
        "tailscaleServe": true
      },
      "lifecycle": {
        "loadStrategy": "startup",
        "idleUnload": false
      }
    },
    {
      "id": "tts-kokoro",
      "name": "Kokoro",
      "capabilityId": "tts",
      "hostId": "home-server",
      "permissions": {
        "enabled": true,
        "protected": false
      },
      "runner": {
        "type": "process",
        "main": ".venv/bin/uvicorn server:app --host 127.0.0.1 --port 8002"
      },
      "ops": {
        "env": {
          "workingDirectory": "~/services/tts/kokoro",
          "variables": {
            "HF_HUB_OFFLINE": "1"
          }
        }
      },
      "network": {
        "port": 8002,
        "healthPath": "/health",
        "tailscaleServe": true
      },
      "lifecycle": {
        "loadStrategy": "demand",
        "autoStart": false,
        "shutdown": true,
        "idleUnload": true,
        "idleTimeout": 1800000,
        "restartOnCrash": true,
        "maxRestarts": 3
      }
    },
    {
      "id": "stt-parakeet",
      "name": "Parakeet",
      "capabilityId": "stt",
      "hostId": "home-server",
      "permissions": {
        "enabled": true,
        "protected": false
      },
      "runner": {
        "type": "process",
        "main": ".venv/bin/parakeet-server --model mlx-community/parakeet-tdt-0.6b-v3 --host 127.0.0.1 --port 8765"
      },
      "ops": {
        "env": {
          "workingDirectory": "~/services/stt/parakeet",
          "variables": {
            "HF_HUB_OFFLINE": "1",
            "PARAKEET_CORS_ORIGINS": "https://home-server.your-tailnet.ts.net:4200,https://home-server.your-tailnet.ts.net:5173"
          }
        }
      },
      "network": {
        "port": 8765,
        "healthPath": "/healthz",
        "tailscaleServe": true
      },
      "lifecycle": {
        "loadStrategy": "demand",
        "autoStart": false,
        "shutdown": true,
        "idleUnload": true,
        "idleTimeout": 1800000,
        "restartOnCrash": true,
        "maxRestarts": 3
      }
    },
    {
      "id": "stt-whisper",
      "name": "Whisper",
      "capabilityId": "stt",
      "hostId": "home-server",
      "permissions": {
        "enabled": true,
        "protected": false
      },
      "runner": {
        "type": "process",
        "main": ".venv/bin/python server.py --model mlx-community/whisper-large-v3-turbo --port 8766"
      },
      "ops": {
        "env": {
          "workingDirectory": "~/services/stt/whisper",
          "variables": {
            "HF_HUB_OFFLINE": "1",
            "WHISPER_CORS_ORIGINS": "https://home-server.your-tailnet.ts.net:4200,https://home-server.your-tailnet.ts.net:5173"
          }
        }
      },
      "network": {
        "port": 8766,
        "healthPath": "/healthz",
        "tailscaleServe": true
      },
      "lifecycle": {
        "loadStrategy": "demand",
        "autoStart": false,
        "shutdown": true,
        "idleUnload": true,
        "idleTimeout": 1800000,
        "restartOnCrash": true,
        "maxRestarts": 3
      }
    }
  ],
  "shards": [
    {
      "hostId": "gpu-machine",
      "port": 4200,
      "scheme": "https",
      "tailscaleServe": true
    }
  ]
}
