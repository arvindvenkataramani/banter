{
  "_comment": "Single-machine starting registry: this machine, the control plane, and two cross-platform speech servers, stt-faster-whisper for transcription and tts-kokoro for synthesis, from services/stt/faster-whisper and services/tts/kokoro. Both are process runners that the control plane starts on first use. Banter does not install them: each runs from a Python venv you create in its ops.env.workingDirectory, following the README in its services folder. The roster section declares what each server offers — its models and the stock voices that need no reference recording — and is what voice mode's choices are built from. Fluid, the Apple Silicon speech servers, is an option: scripts/fluid-build.sh builds it, and services/fluid/README.md covers registering it. Add more hosts, capabilities, services and shards as you need them; docs/reference/configuration.md covers every field.",
  "version": 4,
  "type": "control",
  "hosts": [
    {
      "id": "this-machine",
      "name": "this-machine",
      "hostname": "localhost",
      "role": "control"
    }
  ],
  "capabilities": [
    {
      "id": "control",
      "name": "Control Plane"
    },
    {
      "id": "stt",
      "name": "Speech-to-Text"
    },
    {
      "id": "tts",
      "name": "Text-to-Speech"
    }
  ],
  "services": [
    {
      "id": "control",
      "name": "Control Plane",
      "capabilityId": "control",
      "hostId": "this-machine",
      "permissions": {
        "enabled": true,
        "protected": true
      },
      "runner": {
        "type": "systemd",
        "unit": "banter",
        "unitFile": "ops/systemd/banter.service.template"
      },
      "network": {
        "port": 4200,
        "healthPath": "/api/health"
      },
      "lifecycle": {
        "loadStrategy": "startup",
        "idleUnload": false
      }
    },
    {
      "id": "stt-faster-whisper",
      "name": "Faster-Whisper STT",
      "notes": "Batch transcription with faster-whisper (CPU or NVIDIA GPU) from services/stt/faster-whisper. Install it first: that folder's README covers it.",
      "capabilityId": "stt",
      "hostId": "this-machine",
      "permissions": {
        "enabled": true,
        "protected": false
      },
      "runner": {
        "type": "process",
        "main": ".venv/bin/uvicorn server:app --host 127.0.0.1 --port {port}"
      },
      "ops": {
        "env": {
          "workingDirectory": "~/services/stt/faster-whisper",
          "variables": {
            "FASTER_WHISPER_MODEL": "turbo",
            "FASTER_WHISPER_DEVICE": "auto",
            "FASTER_WHISPER_CORS_ORIGINS": "http://localhost:4200,http://localhost:5173"
          }
        }
      },
      "network": {
        "port": 8766,
        "healthPath": "/healthz"
      },
      "lifecycle": {
        "loadStrategy": "demand",
        "autoStart": false,
        "shutdown": true,
        "idleUnload": true,
        "idleTimeout": 1800000,
        "startupTime": 180000,
        "restartOnCrash": true,
        "maxRestarts": 3
      },
      "provides": [
        {
          "api": "openai.audio.transcriptions",
          "omits": [
            "parameter:languages",
            "parameter:keywords",
            "parameter:prompt",
            "parameter:temperature",
            "parameter:include",
            "parameter:timestamp_granularities",
            "parameter:stream",
            "parameter:chunking_strategy",
            "parameter:known_speaker_names",
            "parameter:known_speaker_references"
          ],
          "restricts": {
            "response_format": [
              "json",
              "text"
            ]
          }
        }
      ],
      "models": {
        "loading": "none"
      }
    },
    {
      "id": "tts-kokoro",
      "name": "Kokoro TTS",
      "notes": "Synthesis with Kokoro (PyTorch, CPU or GPU) from services/tts/kokoro, answering in WAV. Install it first: that folder's README covers it.",
      "capabilityId": "tts",
      "hostId": "this-machine",
      "permissions": {
        "enabled": true,
        "protected": false
      },
      "runner": {
        "type": "process",
        "main": ".venv/bin/uvicorn server:app --host 127.0.0.1 --port {port}"
      },
      "ops": {
        "env": {
          "workingDirectory": "~/services/tts/kokoro",
          "variables": {
            "KOKORO_CORS_ORIGINS": "http://localhost:4200,http://localhost:5173"
          }
        }
      },
      "network": {
        "port": 8002,
        "healthPath": "/health"
      },
      "lifecycle": {
        "loadStrategy": "demand",
        "autoStart": false,
        "shutdown": true,
        "idleUnload": true,
        "idleTimeout": 1800000,
        "startupTime": 90000,
        "restartOnCrash": true,
        "maxRestarts": 3
      },
      "provides": [
        {
          "api": "openai.audio.speech",
          "omits": [
            "parameter:instructions",
            "parameter:stream_format"
          ],
          "restricts": {
            "response_format": [
              "wav"
            ]
          }
        }
      ],
      "models": {
        "loading": "required",
        "autoLoad": "always",
        "resident": "one",
        "load": {
          "method": "POST",
          "path": "/v1/models",
          "query": {
            "model_name": "{model}"
          }
        },
        "unload": {
          "method": "DELETE",
          "path": "/v1/models",
          "query": {
            "model_name": "{model}"
          }
        }
      }
    }
  ],
  "intervals": {
    "healthMs": 900000,
    "shardPollMs": 900000
  },
  "roster": {
    "ttsModels": [
      {
        "id": "kokoro-82m",
        "name": "Kokoro 82M"
      }
    ],
    "sttModels": [
      {
        "id": "faster-whisper",
        "name": "Whisper (faster-whisper)",
        "kind": "batch"
      }
    ],
    "providers": {
      "tts-kokoro": {
        "resolvesVoices": false,
        "serves": [
          {
            "model": "kokoro-82m",
            "key": "kokoro-82m",
            "realtime": false,
            "streaming": false
          }
        ]
      },
      "stt-faster-whisper": {
        "serves": [
          {
            "model": "faster-whisper",
            "key": "faster-whisper"
          }
        ]
      }
    },
    "voices": [
