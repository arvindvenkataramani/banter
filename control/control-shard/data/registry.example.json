{
  "version": 3,
  "type": "shard",
  "servicesRoot": "~/services",
  "defaults": {
    "permissions": {
      "protected": false
    },
    "lifecycle": {
      "loadStrategy": "startup",
      "idleUnload": false,
      "idleTimeout": 300000,
      "startupTime": 30000,
      "serveRetryAttempts": 3,
      "serveRetryDelay": 250
    },
    "network": {
      "scheme": "https"
    }
  },
  "hosts": [
    {
      "id": "gpu-machine",
      "name": "gpu-machine",
      "hostname": "gpu-machine.your-tailnet.ts.net",
      "role": "worker"
    },
    {
      "id": "home-server",
      "name": "home-server",
      "hostname": "home-server.your-tailnet.ts.net",
      "role": "control",
      "port": 4200
    }
  ],
  "capabilities": [
    {
      "id": "control",
      "name": "Control Shard"
    },
    {
      "id": "dashboard",
      "name": "Dashboard"
    },
    {
      "id": "embedding",
      "name": "Embedding"
    },
    {
      "id": "tts",
      "name": "Text-to-Speech"
    },
    {
      "id": "stt",
      "name": "Speech-to-Text"
    },
    {
      "id": "llm",
      "name": "Large Language Model"
    },
    {
      "id": "research",
      "name": "Research"
    }
  ],
  "services": [
    {
      "id": "control-shard",
      "name": "Control Shard",
      "capabilityId": "control",
      "hostId": "gpu-machine",
      "permissions": {
        "enabled": true,
        "protected": true
      },
      "runner": {
        "type": "launchd",
        "label": "com.banter.control-shard",
        "plist": "control/control-shard/ops/com.banter.control-shard.plist"
      },
      "network": {
        "port": 4200,
        "healthPath": "/api/health",
        "tailscaleServe": true
      },
      "lifecycle": {
        "loadStrategy": "startup",
        "idleUnload": false
      }
    },
    {
      "id": "stt-faster-whisper",
      "name": "Faster-Whisper STT",
      "notes": "Batch transcription with faster-whisper (CPU or NVIDIA GPU) from services/stt/faster-whisper. Install it first: that folder's README covers it.",
      "capabilityId": "stt",
      "hostId": "gpu-machine",
      "permissions": {
        "enabled": true,
        "protected": false
      },
      "runner": {
        "type": "process",
        "main": ".venv/bin/uvicorn server:app --host 127.0.0.1 --port {port}"
      },
      "ops": {
        "env": {
          "workingDirectory": "~/services/stt/faster-whisper",
          "variables": {
            "FASTER_WHISPER_MODEL": "turbo",
            "FASTER_WHISPER_DEVICE": "auto",
            "FASTER_WHISPER_CORS_ORIGINS": "https://home-server.your-tailnet.ts.net:4200,https://home-server.your-tailnet.ts.net:5173"
          }
        }
      },
      "network": {
        "port": 8766,
        "healthPath": "/healthz",
        "tailscaleServe": true
      },
      "lifecycle": {
        "loadStrategy": "demand",
        "autoStart": false,
        "shutdown": true,
        "idleUnload": true,
        "idleTimeout": 1800000,
        "startupTime": 180000,
        "restartOnCrash": true,
        "maxRestarts": 3
      }
    },
    {
      "id": "tts-kokoro",
      "name": "Kokoro TTS",
      "notes": "Synthesis with Kokoro (PyTorch, CPU or GPU) from services/tts/kokoro, answering in WAV. Install it first: that folder's README covers it.",
      "capabilityId": "tts",
      "hostId": "gpu-machine",
      "permissions": {
        "enabled": true,
        "protected": false
      },
      "runner": {
        "type": "process",
        "main": ".venv/bin/uvicorn server:app --host 127.0.0.1 --port {port}"
      },
      "ops": {
        "env": {
          "workingDirectory": "~/services/tts/kokoro",
          "variables": {
            "KOKORO_CORS_ORIGINS": "https://home-server.your-tailnet.ts.net:4200,https://home-server.your-tailnet.ts.net:5173"
          }
        }
      },
      "network": {
        "port": 8002,
        "healthPath": "/health",
        "tailscaleServe": true
      },
      "lifecycle": {
        "loadStrategy": "demand",
        "autoStart": false,
        "shutdown": true,
        "idleUnload": true,
        "idleTimeout": 1800000,
        "startupTime": 90000,
        "restartOnCrash": true,
        "maxRestarts": 3
      }
    }
  ],
  "intervals": {
    "healthMs": 900000
  },
