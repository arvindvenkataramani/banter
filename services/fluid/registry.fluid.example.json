{
  "_comment": "The fluid speech servers (Apple Silicon), as registry entries to add to your registry.json. Merge it by id, as services/fluid/README.md shows: append the two services, add the two providers, and add each model and voice whose id your registry does not already declare. Kokoro is the model kokoro-82m, which fluid-tts serves under its own key kokoro-ane, and the voices are the same voices the example registries declare, so a voice you already have is offered on fluid-tts too. Set each service's hostId to a host in your registry (this-machine in the control-plane example). Build with scripts/fluid-build.sh, install with ops/control-install-services.sh, and set FLUID_CORS_ORIGINS to your dashboard origins. scripts/fluid-smoke.sh reads this file.",
  "services": [
    {
      "id": "fluid-stt",
      "name": "Fluid STT",
      "notes": "Transcription from the services/fluid package. Shares FluidServerKit with fluid-tts and pins an exact FluidAudio release.",
      "capabilityId": "stt",
      "hostId": "this-machine",
      "permissions": {
        "enabled": true,
        "protected": false
      },
      "runner": {
        "type": "process",
        "main": "fluid-stt.app/Contents/MacOS/fluid-stt --port {port} --registry {registry} --provider fluid-stt"
      },
      "ops": {
        "env": {
          "workingDirectory": "~/services/fluid/fluid-stt",
          "variables": {
            "PATH": "/opt/homebrew/bin:$PATH",
            "FLUID_CORS_ORIGINS": "http://localhost:4200,http://localhost:5173"
          }
        },
        "install": {
          "artifacts": [
            {
              "from": "services/fluid/.build/release/fluid-stt.app",
              "to": "fluid-stt.app"
            }
          ]
        }
      },
      "network": {
        "port": 8767,
        "healthPath": "/healthz"
      },
      "lifecycle": {
        "loadStrategy": "demand",
        "autoStart": false,
        "shutdown": true,
        "idleUnload": true,
        "idleTimeout": 1800000,
        "restartOnCrash": true,
        "maxRestarts": 3
      },
      "provides": [
        {
          "api": "fluid.stt.stream"
        },
        {
          "api": "openai.audio.transcriptions",
          "omits": [
            "parameter:language",
            "parameter:languages",
            "parameter:keywords",
            "parameter:prompt",
            "parameter:temperature",
            "parameter:include",
            "parameter:stream",
            "parameter:chunking_strategy",
            "parameter:known_speaker_names",
            "parameter:known_speaker_references"
          ],
          "restricts": {
            "response_format": [
              "json",
              "text",
              "verbose_json"
            ]
          }
        }
      ],
      "models": {
        "loading": "required",
        "autoLoad": "always",
        "resident": "one"
      }
    },
    {
      "id": "fluid-tts",
      "name": "Fluid TTS",
      "notes": "Synthesis over HTTP and WebSocket from the services/fluid package. AAC by default, WAV on request.",
      "capabilityId": "tts",
      "hostId": "this-machine",
      "permissions": {
        "enabled": true,
        "protected": false
      },
      "runner": {
        "type": "process",
        "main": "fluid-tts.app/Contents/MacOS/fluid-tts --port {port} --registry {registry} --provider fluid-tts"
      },
      "ops": {
        "env": {
          "workingDirectory": "~/services/fluid/fluid-tts",
          "variables": {
            "PATH": "/opt/homebrew/bin:$PATH",
            "FLUID_CORS_ORIGINS": "http://localhost:4200,http://localhost:5173"
          }
        },
        "install": {
          "artifacts": [
            {
              "from": "services/fluid/.build/release/fluid-tts.app",
              "to": "fluid-tts.app"
            }
          ]
        }
      },
      "network": {
        "port": 8769,
        "healthPath": "/healthz"
      },
      "lifecycle": {
        "loadStrategy": "demand",
        "autoStart": false,
        "shutdown": true,
        "idleUnload": true,
        "idleTimeout": 1800000,
        "restartOnCrash": true,
        "maxRestarts": 3
      },
      "provides": [
        {
          "api": "openai.audio.speech",
          "omits": [
            "parameter:instructions",
            "parameter:stream_format"
          ],
          "restricts": {
            "response_format": [
              "aac",
              "wav",
              "pcm"
            ]
          },
          "extends": [
            "stream-flag",
            "cloning-reference"
          ]
        }
      ],
      "models": {
        "loading": "required",
        "autoLoad": "always",
        "resident": "one"
      }
    }
  ],
  "roster": {
    "ttsModels": [
      {
        "id": "kokoro-82m",
        "name": "Kokoro 82M"
      },
      {
        "id": "luxtts",
        "name": "LuxTTS",
        "cloning": {
          "requiresText": true,
          "maxDurationS": 5
        }
      },
      {
        "id": "pocket-tts",
        "name": "Pocket-TTS",
        "cloning": {
          "requiresText": false
        },
        "chunkProfile": {
          "words": 75,
          "chars": 400
        }
      }
    ],
    "sttModels": [
      {
        "id": "parakeet-tdt-v3",
        "name": "Parakeet TDT v3",
        "kind": "batch"
      },
      {
        "id": "parakeet-unified-0.6b",
        "name": "Parakeet Unified 0.6B",
        "kind": "both"
      },
      {
        "id": "nemotron-streaming-en-0.6b",
        "name": "Nemotron Streaming EN 0.6B",
        "kind": "streaming",
        "params": [
          {
            "name": "chunkMs",
            "values": [
              560,
              1120,
              2240
            ]
          }
        ],
        "variants": [
          {
            "id": "560ms",
            "params": [
              {
                "name": "chunkMs",
                "value": 560
              }
            ]
          },
          {
            "id": "1120ms",
            "params": [
              {
                "name": "chunkMs",
                "value": 1120
              }
            ]
          },
          {
            "id": "2240ms",
            "params": [
              {
                "name": "chunkMs",
                "value": 2240
              }
            ]
          }
        ]
      }
    ],
    "providers": {
      "fluid-tts": {
        "resolvesVoices": true,
        "responseFormat": "aac",
        "sessions": true,
        "serves": [
          {
            "model": "pocket-tts",
            "key": "pocket-tts",
            "realtime": true,
            "streaming": true
          },
          {
            "model": "kokoro-82m",
            "key": "kokoro-ane",
            "realtime": true,
            "streaming": false
          },
          {
            "model": "luxtts",
            "key": "luxtts",
            "realtime": true,
            "streaming": false
          }
        ]
      },
      "fluid-stt": {
        "sessions": true,
        "defaultModel": "parakeet-unified-0.6b",
        "idleUnloadMs": 1800000,
        "serves": [
          {
            "model": "parakeet-tdt-v3",
            "key": "parakeet-tdt-v3"
          },
          {
            "model": "parakeet-unified-0.6b",
            "key": "parakeet-unified-0.6b"
          },
          {
            "model": "nemotron-streaming-en-0.6b",
            "key": "nemotron-streaming-en-0.6b"
          }
        ]
      }
    },
    "voices": [
