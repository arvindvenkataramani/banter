{
  "_comment": "The fluid speech servers (Apple Silicon), as registry entries to add to your registry.json. Append the two services to services, the two providers to roster.providers, and the voices to roster.voices; nothing in it collides with the default registry, because the voice ids carry a fluid- prefix and the model ids (kokoro-ane, pocket-tts, luxtts) differ from the default ones. Set each service's hostId to a host in your registry (this-machine in the control-plane example). Build with scripts/fluid-build.sh, install with scripts/control-install-services.sh, and set FLUID_CORS_ORIGINS to your dashboard origins. scripts/fluid-smoke.sh reads this file.",
  "services": [
    {
      "id": "fluid-stt",
      "name": "Fluid STT",
      "notes": "Transcription from the services/fluid package. Shares FluidServerKit with fluid-tts and pins the patched FluidAudio fork.",
      "capabilityId": "stt",
      "hostId": "this-machine",
      "permissions": {
        "enabled": true,
        "protected": false
      },
      "runner": {
        "type": "process",
        "main": "fluid-stt.app/Contents/MacOS/fluid-stt --port {port} --registry {registry} --provider fluid-stt"
      },
      "ops": {
        "env": {
          "workingDirectory": "~/services/fluid/fluid-stt",
          "variables": {
            "PATH": "/opt/homebrew/bin:$PATH",
            "FLUID_CORS_ORIGINS": "http://localhost:4200,http://localhost:5173"
          }
        },
        "install": {
          "artifacts": [
            {
              "from": "services/fluid/.build/release/fluid-stt.app",
              "to": "fluid-stt.app"
            }
          ]
        }
      },
      "network": {
        "port": 8767,
        "healthPath": "/healthz"
      },
      "lifecycle": {
        "loadStrategy": "demand",
        "autoStart": false,
        "shutdown": true,
        "idleUnload": true,
        "idleTimeout": 1800000,
        "restartOnCrash": true,
        "maxRestarts": 3
      }
    },
    {
      "id": "fluid-tts",
      "name": "Fluid TTS",
      "notes": "Synthesis over HTTP and WebSocket from the services/fluid package. AAC by default, WAV on request.",
      "capabilityId": "tts",
      "hostId": "this-machine",
      "permissions": {
        "enabled": true,
        "protected": false
      },
      "runner": {
        "type": "process",
        "main": "fluid-tts.app/Contents/MacOS/fluid-tts --port {port} --registry {registry} --provider fluid-tts"
      },
      "ops": {
        "env": {
          "workingDirectory": "~/services/fluid/fluid-tts",
          "variables": {
            "PATH": "/opt/homebrew/bin:$PATH",
            "FLUID_CORS_ORIGINS": "http://localhost:4200,http://localhost:5173"
          }
        },
        "install": {
          "artifacts": [
            {
              "from": "services/fluid/.build/release/fluid-tts.app",
              "to": "fluid-tts.app"
            }
          ]
        }
      },
      "network": {
        "port": 8769,
        "healthPath": "/healthz"
      },
      "lifecycle": {
        "loadStrategy": "demand",
        "autoStart": false,
        "shutdown": true,
        "idleUnload": true,
        "idleTimeout": 1800000,
        "restartOnCrash": true,
        "maxRestarts": 3
      }
    }
  ],
