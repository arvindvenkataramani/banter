#!/usr/bin/env bash
# Tracked hooks, shared by every clone: scripts/install.sh points
# core.hooksPath here. In a clone that did not run it:
#   git config core.hooksPath scripts/git-hooks

# docs/reference/api.md is generated from the route definitions under control/.
# A commit touching control/ carries the reference regenerated from it, so the
# file in the repo always matches the code beside it. A failed generation warns
# and lets the commit through.
if git diff --cached --name-only -- control/ | grep -q .; then
  root="$(git rev-parse --show-toplevel)"
  if (cd "$root" && bun run docs >/dev/null 2>&1); then
    if ! git diff --quiet -- "$root/docs/reference/api.md"; then
      git add -- "$root/docs/reference/api.md"
      echo "[pre-commit] docs/reference/api.md regenerated and added to this commit."
    fi
  else
    echo "[pre-commit] warning: bun run docs failed; docs/reference/api.md not regenerated." >&2
  fi
fi

# The example config.json and registry.json files carry the schema's version and
# defaults. A commit touching control/ syncs them and takes any change into the
# commit.
if git diff --cached --name-only -- control/ | grep -q .; then
  root="$(git rev-parse --show-toplevel)"
  templates="control/control-plane/data/config.example.json control/control-plane/data/registry.example.json control/control-shard/data/registry.example.json"
  if (cd "$root/control" && bun run config:sync >/dev/null 2>&1); then
    if ! (cd "$root" && git diff --quiet -- $templates); then
      (cd "$root" && git add -- $templates)
      echo "[pre-commit] example config and registry files synced and added to this commit."
    fi
  else
    echo "[pre-commit] warning: bun run config:sync failed; examples not synced." >&2
  fi
fi
exit 0
