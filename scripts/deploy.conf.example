# Per-machine deploy settings. Copy to deploy.conf and edit; deploy.conf is
# untracked, so your paths stay out of the repository.
#
#   cp scripts/deploy.conf.example scripts/deploy.conf
#
# It stays in the checkout's scripts/ because it names the deployment folder,
# which the deployed scripts cannot find without it. A deploy copies it into
# $BANTER_PROD/scripts/, so the scripts systemd runs read the same settings.
#
# Everything here is optional — the commented values are the defaults, and an
# ordinary install needs no file at all. A variable already set in the
# environment wins over this file, for one-off deploys.

# Where the control plane installs, and what its systemd unit is called.
# Set both together: a second deployment on one machine needs its own directory
# *and* its own unit name, or `systemctl --user restart banter` acts on
# whichever install happens to hold that name.
#BANTER_PROD="$HOME/services/banter"
#BANTER_UNIT="banter"

# The control plane's live directory and the files derived from it. The live
# directory is the deployed folder itself: config.json, registry.json, shipped/
# and state/ sit at its top, and a deploy never deletes them.
#BANTER_LIVE_DIR="$BANTER_PROD"
#BANTER_REGISTRY_PATH="$BANTER_LIVE_DIR/registry.json"
#BANTER_CONFIG_PATH="$BANTER_LIVE_DIR/config.json"
#BANTER_EVENTS_PATH="$BANTER_PROD/logs/events.jsonl"

# Where a deploy stages an extracted tree.
#BANTER_STAGE_DIR="/var/tmp/banter-deploy-$(id -u)"

# The shard's equivalent, on a worker machine. A machine runs one node, so this
# is the same default folder as the control plane's.
#BANTER_SHARD_PROD="$HOME/services/banter"
#BANTER_SHARD_LIVE_DIR="$BANTER_SHARD_PROD"
#BANTER_SHARD_REGISTRY_PATH="$BANTER_SHARD_LIVE_DIR/registry.json"
#BANTER_SHARD_EVENTS_PATH="$BANTER_SHARD_PROD/logs/events.jsonl"
