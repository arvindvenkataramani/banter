  "extensions": [
    {
      "id": "session-claim",
      "adds": "`session` and `takeover` query parameters at connect, and close codes 4001 to 4010 naming why a connection was refused or displaced",
      "reference": { "document": "services/fluid/STT.md", "revision": "in-repo", "part": "Streaming" }
    },
    {
      "id": "cloning-reference",
      "adds": "`ref_audio`, a path on the service's own machine, and `ref_text`",
      "reference": { "document": "docs/reference/design/service-apis.md", "revision": "in-repo", "part": "cloning-reference" }
    },
    {
      "id": "stream-flag",
      "adds": "`stream: true` on a speech request asks for audio as it renders",
      "reference": { "document": "docs/reference/design/service-apis.md", "revision": "in-repo", "part": "stream-flag" }
    },
    {
      "id": "opus-input",
      "adds": "on Realtime, an Opus input format: each `input_audio_buffer.append` carries one raw Opus packet, base64-encoded as the spec encodes PCM",
      "reference": { "document": "docs/reference/design/service-apis.md", "revision": "in-repo", "part": "opus-input" }
    },
    {
      "id": "voice-param",
      "adds": "a `voice` parameter at connect, where the spec selects a voice through `model` alone",
      "reference": { "document": "docs/reference/design/service-apis.md", "revision": "in-repo", "part": "voice-param" }
    },
    {
      "id": "verbatim-speech",
      "adds": "on Realtime, `response.create` speaks the text of its `input_text` parts as written and runs no model",
      "reference": { "document": "docs/reference/design/service-apis.md", "revision": "in-repo", "part": "verbatim-speech" }
    },
    {
      "id": "finalize-answered",
      "adds": "every `Finalize` is answered by exactly one result marked as answering it, including an empty one",
      "reference": { "document": "services/fluid/STT.md", "revision": "in-repo", "part": "Deepgram /v1/listen" }
    },
    {
      "id": "endpointing-off",
      "adds": "`endpointing=false` stops the server closing utterances on its own",
      "reference": { "document": "services/fluid/STT.md", "revision": "in-repo", "part": "Deepgram /v1/listen" }
    },
    {
      "id": "opus-packets",
      "adds": "with `encoding=opus`, each binary message is one raw Opus packet",
      "reference": { "document": "services/fluid/STT.md", "revision": "in-repo", "part": "Streaming" }
    },
    {
      "id": "resident-slot",
      "adds": "on the model repository API: `mode` and `variant` as load parameters; a load of what is already resident changes nothing; a load replaces the one resident model; a load that would change the model, and an unload, are refused while a session holds it",
      "reference": { "document": "services/fluid/STT.md", "revision": "in-repo", "part": "Model repository" }
    }
  ]
